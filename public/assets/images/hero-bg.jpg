<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#f4efe7" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&amp;family=Manrope:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
  <title>Invitation not found | Naqsh Digital Invites</title>
</head>
<body class="error-page">
  <main class="error-page__content">
    <a class="brand" href="/" aria-label="Naqsh Digital Invites home">
      <svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M24 3 31.2 16.8 45 24l-13.8 7.2L24 45l-7.2-13.8L3 24l13.8-7.2L24 3Z" />
        <path d="M24 10.5 28.9 19.1 37.5 24l-8.6 4.9L24 37.5l-4.9-8.6L10.5 24l8.6-4.9L24 10.5Z" />
        <circle cx="24" cy="24" r="2.2" />
      </svg>
      <span class="brand__type"><strong>Naqsh</strong><small>Digital Invites</small></span>
    </a>

    <div class="error-page__message">
      <p class="section-kicker">404 · Invitation not found</p>
      <h1>This path doesn’t lead to an invitation.</h1>
      <p>The invitation may have moved, or the link may be incomplete. Return to Naqsh to explore the current invitation worlds.</p>
      <div class="error-page__actions">
        <a class="button button--dark" href="/#collection">Explore invitations</a>
        <a class="text-link" href="https://instagram.com/naqsh_digital/" target="_blank" rel="noopener noreferrer">Message us on Instagram</a>
      </div>
    </div>
  </main>
</body>
</html>
